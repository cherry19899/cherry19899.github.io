# Copy to .env.local and set your API URL before running `npm run dev` or `npm run build`
VITE_API_BASE=https://workpro-api.onrender.com

# Which network this build talks to. Display only — it drives the "Testnet" /
# "Mainnet" line on the login screen. The actual network is decided by the
# backend's PI_API_KEY (the app registration it belongs to), not here.
# 'sandbox' | 'production'. Defaults to 'production' in production builds.
VITE_PI_MODE=sandbox

# Pi.init({ sandbox }) — a DIFFERENT question from the network above.
# sandbox=true drives the app from a desktop browser against Pi's sandbox
# environment. Inside Pi Browser it must be false, Testnet apps included:
# with it on, Pi.authenticate never calls back and login hangs until the 20s
# timeout. Leave unset (defaults: on for `npm run dev`, off for any build).
# VITE_PI_SANDBOX=true
